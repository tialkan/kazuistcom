# /etc/kazuist/backup.env on the server (root:root, chmod 600). Names only; values never enter the repository.
# docs/runbook/yedek.md explains each value and where it comes from.

# restic repository. Hetzner Storage Box over SFTP (port 23 through /etc/kazuist/ssh/config, host alias "storagebox"):
#   RESTIC_REPOSITORY=sftp:storagebox:kazuist-restic
# or an S3 compatible bucket:
#   RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/kazuist-restic
RESTIC_REPOSITORY=
# File holding the repository password (root:root, chmod 600). Losing it makes every backup unreadable: keep a copy
# in the Kulular password manager.
RESTIC_PASSWORD_FILE=/etc/kazuist/restic-password
# Only for an S3 repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Heartbeats of the external monitor (docs/runbook/izleme.md). Empty disables the ping.
KAZUIST_BACKUP_PING_OK_URL=
KAZUIST_BACKUP_PING_FAIL_URL=
KAZUIST_DISK_PING_OK_URL=
KAZUIST_DISK_PING_FAIL_URL=

# Defaults; change only if the layout differs.
# KAZUIST_RAW_STORE_DIR=/srv/kazuist/raw-store
# KAZUIST_BACKUP_WORK_DIR=/var/lib/kazuist-backup
# KAZUIST_RESTIC_SSH_DIR=/etc/kazuist/ssh
# KAZUIST_DISK_LIMIT_PCT=80
# KAZUIST_BACKUP_MAX_AGE_HOURS=8
