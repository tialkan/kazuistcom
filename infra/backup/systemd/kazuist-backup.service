# Installed by docs/runbook/ilk-kurulum.md (symlink into /etc/systemd/system, then systemctl daemon-reload).
[Unit]
Description=Kazuist off-server encrypted backup (restic)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/kazuist/infra/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
