# Kazuist environment variables. Copy to .env and fill locally. Never commit real values.
# Production values live only in Coolify secret variables. There is no staging server (ADR-0033): the chain is
# local, CI, then a closed pre-launch rehearsal on the single production server.
# Lines marked [gelecek faz] are placeholders that no code reads yet; leave them empty until the owner wires them.

# --- Application ---
# Public base URL of the web app (for example http://localhost:3000 locally). worker-node uses it in links.
APP_URL=
# Version string shown by /api/version; set by CI at build time.
APP_VERSION=
# Git commit sha shown by /api/version; set by CI at build time.
GIT_COMMIT=
# ISO 8601 build time shown by /api/version; set by CI at build time.
BUILT_AT=
# development or production (default development); read by the legal text loader (production also needs
# NODE_ENV=production) and by worker-py source approval checks. "staging" is still accepted and now means the closed
# pre-launch rehearsal on the production server, not a separate server (ADR-0033).
# worker-py anonymizer: any value other than development or test (staging, production, a typo) requires an NER
# model; without KAZUIST_NER_BACKEND anon.run holds every record for review. The worker-py image defaults to
# production. apps/web: a production build (NODE_ENV=production) hides the deferred modules unless this says
# development or test (ADR-0038, KAZUIST_MODULLER below). Set it explicitly on every deployed service.
KAZUIST_ENV=

# --- Database (critical for /api/health) ---
# PostgreSQL connection string with pgvector, for example postgres://kazuist:<password>@127.0.0.1:5432/kazuist
DATABASE_URL=
# Password used by infra/docker-compose.dev.yml for the local postgres container only.
POSTGRES_PASSWORD=

# --- Cache and rate limit (critical for /api/health) ---
# Valkey connection string, for example redis://127.0.0.1:6379 (client: iovalkey).
VALKEY_URL=

# --- Authentication (critical) ---
# Better Auth secret, at least 32 random bytes (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Better Auth base URL, same origin as APP_URL.
BETTER_AUTH_URL=
# Extra web origins allowed to call /api/auth, comma separated (APP_URL is always allowed).
AUTH_TRUSTED_ORIGINS=
# Number of reverse proxies in front of the app (Coolify Traefik: 1). Used for the client IP in rate limits.
TRUSTED_PROXY_COUNT=
# Google OAuth client id and secret (Google Cloud Console, Kulular account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: Services ID, the signed client secret JWT, and the iOS bundle id for id tokens.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# [gelecek faz] Team id, key id and .p8 private key (PEM, single line with \n) that would sign APPLE_CLIENT_SECRET;
# no code reads them yet, the JWT above is generated outside the app.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts personal identifiers at rest, for example the
# identity number of a KVKK application without an account (kvkk_requests.identity_enc, ADR-0023).
PII_ENCRYPTION_KEY=
# Days between account deletion and the permanent purge job, 1 to 30 (empty means the default 14, ADR-0023).
ACCOUNT_PURGE_GRACE_DAYS=

# --- BYOK protocol (critical) ---
# HMAC secret that signs /v1/answers/prepare packages (nonce valid 10 minutes).
BYOK_SIGNING_SECRET=

# --- Object storage (critical for /api/health) ---
# S3 compatible endpoint (SeaweedFS locally, http://127.0.0.1:9000; ADR-0021). In production it sits with the
# single Hetzner server in the EU (ADR-0030, ADR-0033). Today /api/health only checks that it is set; no code
# uploads to S3 yet (review.md P2 madde 4).
S3_ENDPOINT=
# Bucket for raw archive and uploads; like S3_ENDPOINT, only checked for presence by /api/health today.
S3_BUCKET=
# [gelecek faz] Region name expected by the provider; no code reads it yet.
S3_REGION=
# Access key pair. Read today only by infra/docker-compose.dev.yml (local SeaweedFS) and CI; [gelecek faz] for the app.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI platform mode (packages/ai-gateway) ---
# Platform provider (ADR-0025): OpenRouter, every request with data_collection deny and ZDR. Only masked
# text is sent.
OPENROUTER_API_KEY=
# Optional direct Anthropic fallback (plan 8.7/3); also the key of the citations Batch layer in worker-py.
ANTHROPIC_API_KEY=
# [gelecek faz] Other direct fallback providers of the kill switch order; no code reads them yet.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Daily platform spend ceiling in TRY; free quota stops above it.
AI_DAILY_BUDGET_TRY=
# Set to 1 only for the local live smoke test (pnpm --filter @kazuist/ai-gateway test:smoke). Never in CI.
KAZUIST_LIVE_SMOKE=

# --- Search and citation network (apps/web /ara, /atif-agi) ---
# "fikstur" serves the packages/casuist fixture corpus (tests, local, screenshots); empty uses DATABASE_URL.
KAZUIST_ARAMA_KAYNAGI=
# 1 lets the fixture corpus run under NODE_ENV=production (local production builds only; never on the server).
KAZUIST_FIKSTUR_URETIMDE=
# Ranking weight override as a flat JSON map (keys like "authority.emsal"), until the admin panel exists.
KAZUIST_ARAMA_AGIRLIK=
# Embedding service URL (services/worker-py/nlp, POST {texts, kind}); the vector leg runs only with URL and model.
KAZUIST_EMBED_URL=
# Embedding model name; the service must answer with the same name, otherwise the vector leg is skipped.
KAZUIST_EMBED_MODEL=
# Embedding vector dimensions (default 1024).
KAZUIST_EMBED_DIM=
# Minimum cosine similarity for vector hits (default 0).
KAZUIST_EMBED_ESIK=

# --- Launch scope (ADR-0038, narrowed core launch) ---
# Deferred modules to open in production, comma separated: pratik, kalemcik, atif-agi, or hepsi for all of them.
# Empty in production keeps the narrowed core (Ara and the sourced summary, Kaydettiklerim, Yazma, Rehberler,
# /tespit). Outside production every module is open anyway. Read at request time by
# apps/web/src/app/(kabuk)/_kabuk/yayin.ts; unknown keys are ignored.
KAZUIST_MODULLER=

# --- Writing and practice modules ---
# "acik" turns on AI guideline rule extraction in Yazma (also needs OPENROUTER_API_KEY); default off.
YAZMA_YZ=
# 1 also serves Pratik cards waiting for editor approval (closed rehearsal only, never after launch).
PRATIK_ONIZLEME=

# --- Payments ---
# iyzico API key, secret and merchant id (sandbox locally, in CI and in the closed rehearsal; live keys only
# with Tarık's explicit approval).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
# iyzico base URL (sandbox https://sandbox-api.iyzipay.com or production).
IYZICO_BASE_URL=
# [gelecek faz] App Store Server API issuer id, key id, private key and bundle id; no code reads them yet.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=
# [gelecek faz] e-Arsiv integrator API base URL and credentials; no code reads them yet (integrator not chosen).
EARSIV_BASE_URL=
EARSIV_USERNAME=
EARSIV_PASSWORD=

# --- E-mail ---
# SMTP URL, for example smtp://user:password@host:587 (Mailpit locally: smtp://127.0.0.1:1025).
# Used by apps/web (codes) and worker-node (notify.send).
MAIL_SMTP_URL=
# Sender address, for example "Kazuist" <bildirim@kazuist.com>
MAIL_FROM=
# TTF font for the frozen contract PDFs of worker-node; the image sets it, default packages/ledger DejaVuSans.ttf.
LEGAL_PDF_FONT_PATH=

# --- Push ---
# Web Push VAPID key pair and subject (mailto: address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# APNs token based auth: key id, team id, private key (PEM, single line with \n) and app bundle id.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# --- Observability ---
# [gelecek faz] GlitchTip DSN (self hosted, Sentry compatible); no SDK is wired yet (review.md P2 madde 6).
GLITCHTIP_DSN=
# [gelecek faz] Umami website id (loaded only after consent); no script is wired yet.
UMAMI_WEBSITE_ID=

# --- Python worker (services/worker-py) ---
# Internal URL of the worker-py FastAPI service (internal network only).
WORKER_PY_URL=
# Internal API: token, bind host and port. Without the token every /internal route answers 503.
KAZUIST_INTERNAL_TOKEN=
KAZUIST_INTERNAL_HOST=
KAZUIST_INTERNAL_PORT=
# Liveness probe of python -m core.main (default 127.0.0.1:8000, path /healthz) and job poll interval.
KAZUIST_HEALTH_HOST=
KAZUIST_HEALTH_PORT=
KAZUIST_POLL_SECONDS=
# Raw archive directory when no S3 store is injected (default ./.raw-store, ignored by git).
KAZUIST_RAW_DIR=
# Directory of the source approval documents (default docs/kaynaklar; the image sets /srv/docs/kaynaklar).
KAZUIST_SOURCES_DIR=
# Per source kill switches, default off; "on" enables. In production the source document must also be
# approved (docs/kaynaklar/<kaynak>.md, tarik_onayi: onaylandi). Read as KAZUIST_SOURCE_<NAME> by core/sources.py.
KAZUIST_SOURCE_MEVZUAT=
KAZUIST_SOURCE_RESMI_GAZETE=
KAZUIST_SOURCE_KVKK=
KAZUIST_SOURCE_REKABET=
KAZUIST_SOURCE_OPENALEX=
KAZUIST_SOURCE_CROSSREF=
KAZUIST_SOURCE_EURLEX=
KAZUIST_SOURCE_AYM=
KAZUIST_SOURCE_YARGITAY=
KAZUIST_SOURCE_DANISTAY=
# Collection scheduler (services/worker-py/core/scheduler.py): "on" starts it inside python -m core.main; default off
# leaves collection to manual runs. It enqueues only for sources that are switched on, approved in production and
# inside their window (01:00-06:00 Istanbul for bulk sources, from 07:00 for the Resmi Gazete).
KAZUIST_SCHEDULER=
# "on" makes the scheduler log its plan without enqueueing anything.
KAZUIST_SCHEDULER_DRY_RUN=
# Seconds between scheduler ticks (default 600, minimum 60).
KAZUIST_SCHEDULE_TICK_SECONDS=
# OpenAlex API key (free, https://help.openalex.org/api-reference/authentication).
OPENALEX_API_KEY=
# "all" extracts citations from every record; default only the 1.0 network scope (HGK, IBK, AYM).
KAZUIST_CITATIONS_SCOPE=
# Path to a file holding the Anthropic key for the citations Batch layer, used when ANTHROPIC_API_KEY is empty.
KAZUIST_ANTHROPIC_KEY_FILE=
# Anthropic API base URL for the citations Batch layer (default https://api.anthropic.com).
ANTHROPIC_BASE_URL=
# Anonymiser NER backend key and local model directory (models are never downloaded at run time). The image
# installs the ner-runtime extra; models come from a read-only volume, for example /models/ner. When the
# backend is set and the model is missing, the worker does not start. Empty outside development: the worker starts
# but publishes nothing (fail closed).
KAZUIST_NER_BACKEND=
KAZUIST_NER_DIR=
# onnxruntime intra-op threads (0 = library default) and 1 to load model_quantized.onnx instead of model.onnx.
KAZUIST_NER_THREADS=
KAZUIST_NER_QUANTIZED=
# Embedding backend of the embed.chunks consumer (services/worker-py/nlp/embedder.py): bge-m3,
# multilingual-e5-large or qwen3-embedding-0.6b; empty or "none" writes chunks without vectors (no candidate is
# measured yet). The stored model id is <key>@<first 7 characters of the revision> and must equal the web side's
# KAZUIST_EMBED_MODEL. Models come from a read-only volume, one folder per key (for example /models/embed; default
# ~/.cache/kazuist-embed); nothing is downloaded at run time. A backend that cannot load falls back to no vectors and
# logs the reason.
KAZUIST_EMBED_BACKEND=
KAZUIST_EMBED_DIR=
# onnxruntime intra-op threads (0 = library default) and 1 to load model_quantized.onnx instead of model.onnx.
KAZUIST_EMBED_THREADS=
KAZUIST_EMBED_QUANTIZED=
# Set both to 1 in every deployed environment: no model hub access at run time. Read by the Hugging Face
# libraries, not by Kazuist code (the eval/anon scripts set them themselves).
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# --- Tests only ---
# Optional real services for apps/web/test/health-deps.test.ts (for example the docker compose stack).
KAZUIST_IT_DATABASE_URL=
KAZUIST_IT_VALKEY_URL=
# Optional throw-away PostgreSQL with pgvector and all migrations for services/worker-py/nlp/tests/test_pg.py; the
# tests write and delete rows, never point it at a database that holds data.
KAZUIST_TEST_DATABASE_URL=
