# Kazuist environment variables. Copy to .env and fill locally. Never commit real values.
# Production and staging values live only in Coolify secret variables.

# --- Application ---
# Public base URL of the web app (for example http://localhost:3000 locally).
APP_URL=
# Version string shown by /api/version; set by CI at build time.
APP_VERSION=
# Git commit sha shown by /api/version; set by CI at build time.
GIT_COMMIT=
# ISO 8601 build time shown by /api/version; set by CI at build time.
BUILT_AT=

# --- Database (critical for /api/health) ---
# PostgreSQL connection string with pgvector, for example postgres://kazuist:<password>@127.0.0.1:5432/kazuist
DATABASE_URL=
# Password used by infra/docker-compose.dev.yml for the local postgres container only.
POSTGRES_PASSWORD=

# --- Cache and rate limit (critical) ---
# Valkey connection string, for example redis://127.0.0.1:6379
VALKEY_URL=

# --- Authentication (critical) ---
# Better Auth secret, at least 32 random bytes (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Better Auth base URL, same origin as APP_URL.
BETTER_AUTH_URL=
# Google OAuth client id and secret (Google Cloud Console, Kulular account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple service id, team id, key id and private key (PEM, single line with \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- BYOK protocol (critical) ---
# HMAC secret that signs /v1/answers/prepare packages (nonce valid 10 minutes).
BYOK_SIGNING_SECRET=

# --- Object storage (critical) ---
# S3 compatible endpoint in Turkey (MinIO locally, http://127.0.0.1:9000).
S3_ENDPOINT=
# Bucket for raw archive and uploads.
S3_BUCKET=
# Region name expected by the provider.
S3_REGION=
# Access key pair; locally also used as MinIO root credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI platform mode ---
# Kazuist organisation key for the platform model provider. Only masked text is sent.
ANTHROPIC_API_KEY=
# Daily platform spend ceiling in TRY; free quota stops above it.
AI_DAILY_BUDGET_TRY=

# --- Payments ---
# iyzico API key and secret (sandbox locally and on staging).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico base URL (sandbox or production).
IYZICO_BASE_URL=
# App Store Server API issuer id, key id, private key and bundle id.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=
# e-Arsiv integrator API base URL and credentials.
EARSIV_BASE_URL=
EARSIV_USERNAME=
EARSIV_PASSWORD=

# --- E-mail ---
# SMTP host and port (Mailpit locally: 127.0.0.1 and 1025).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Sender address, for example bildirim@kazuist.com
MAIL_FROM=

# --- Push ---
# Web Push VAPID key pair and subject (mailto: address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# APNs token based auth: key id, team id, private key.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Observability ---
# GlitchTip DSN (self hosted, Sentry compatible).
GLITCHTIP_DSN=
# Umami website id (loaded only after consent).
UMAMI_WEBSITE_ID=

# --- Python worker ---
# Internal URL of the worker-py FastAPI service (internal network only).
WORKER_PY_URL=
