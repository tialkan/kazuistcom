# Kazuist environment variables. Copy to .env and fill locally. Never commit real values.
# Production and staging values live only in Coolify secret variables.

# --- Application ---
# Public base URL of the web app (for example http://localhost:3000 locally). worker-node uses it in links.
APP_URL=
# Version string shown by /api/version; set by CI at build time.
APP_VERSION=
# Git commit sha shown by /api/version; set by CI at build time.
GIT_COMMIT=
# ISO 8601 build time shown by /api/version; set by CI at build time.
BUILT_AT=
# Deployment environment for worker-py source approval checks: development, staging or production.
KAZUIST_ENV=

# --- Database (critical for /api/health) ---
# PostgreSQL connection string with pgvector, for example postgres://kazuist:<password>@127.0.0.1:5432/kazuist
DATABASE_URL=
# Password used by infra/docker-compose.dev.yml for the local postgres container only.
POSTGRES_PASSWORD=

# --- Cache and rate limit (critical for /api/health) ---
# Valkey connection string, for example redis://127.0.0.1:6379 (client: iovalkey).
VALKEY_URL=

# --- Authentication (critical) ---
# Better Auth secret, at least 32 random bytes (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Better Auth base URL, same origin as APP_URL.
BETTER_AUTH_URL=
# Extra web origins allowed to call /api/auth, comma separated (APP_URL is always allowed).
AUTH_TRUSTED_ORIGINS=
# Number of reverse proxies in front of the app (Coolify Traefik: 1). Used for the client IP in rate limits.
TRUSTED_PROXY_COUNT=
# Google OAuth client id and secret (Google Cloud Console, Kulular account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: Services ID, the signed client secret JWT, and the iOS bundle id for id tokens.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Team id, key id and .p8 private key (PEM, single line with \n) that sign APPLE_CLIENT_SECRET.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts personal identifiers at rest, for example the
# identity number of a KVKK application without an account (kvkk_requests.identity_enc, ADR-0023).
PII_ENCRYPTION_KEY=

# --- BYOK protocol (critical) ---
# HMAC secret that signs /v1/answers/prepare packages (nonce valid 10 minutes).
BYOK_SIGNING_SECRET=

# --- Object storage (critical) ---
# S3 compatible endpoint in Turkey (SeaweedFS locally, http://127.0.0.1:9000; ADR-0021).
S3_ENDPOINT=
# Bucket for raw archive and uploads.
S3_BUCKET=
# Region name expected by the provider.
S3_REGION=
# Access key pair; locally also the SeaweedFS S3 credentials of infra/docker-compose.dev.yml.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI platform mode (packages/ai-gateway) ---
# Platform provider (ADR-0025): OpenRouter, every request with data_collection deny and ZDR. Only masked
# text is sent.
OPENROUTER_API_KEY=
# Optional direct fallback providers for the kill switch order (plan 8.7/3). Leave empty to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Daily platform spend ceiling in TRY; free quota stops above it.
AI_DAILY_BUDGET_TRY=
# Set to 1 only for the local live smoke test (pnpm --filter @kazuist/ai-gateway test:smoke). Never in CI.
KAZUIST_LIVE_SMOKE=

# --- Payments ---
# iyzico API key, secret and merchant id (sandbox locally and on staging).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
# iyzico base URL (sandbox https://sandbox-api.iyzipay.com or production).
IYZICO_BASE_URL=
# App Store Server API issuer id, key id, private key and bundle id.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=
# e-Arsiv integrator API base URL and credentials.
EARSIV_BASE_URL=
EARSIV_USERNAME=
EARSIV_PASSWORD=

# --- E-mail ---
# SMTP URL, for example smtp://user:password@host:587 (Mailpit locally: smtp://127.0.0.1:1025).
# Used by apps/web (codes) and worker-node (notify.send).
MAIL_SMTP_URL=
# Sender address, for example "Kazuist" <bildirim@kazuist.com>
MAIL_FROM=

# --- Push ---
# Web Push VAPID key pair and subject (mailto: address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# APNs token based auth: key id, team id, private key (PEM, single line with \n) and app bundle id.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# --- Observability ---
# GlitchTip DSN (self hosted, Sentry compatible).
GLITCHTIP_DSN=
# Umami website id (loaded only after consent).
UMAMI_WEBSITE_ID=

# --- Python worker (services/worker-py) ---
# Internal URL of the worker-py FastAPI service (internal network only).
WORKER_PY_URL=
# Internal API: token, bind host and port. Without the token every /internal route answers 503.
KAZUIST_INTERNAL_TOKEN=
KAZUIST_INTERNAL_HOST=
KAZUIST_INTERNAL_PORT=
# Liveness probe of python -m core.main (default 127.0.0.1:8000, path /healthz) and job poll interval.
KAZUIST_HEALTH_HOST=
KAZUIST_HEALTH_PORT=
KAZUIST_POLL_SECONDS=
# Raw archive directory when no S3 store is injected (default ./.raw-store, ignored by git).
KAZUIST_RAW_DIR=
# Per source kill switches, default off; "on" enables. In production the source document must also be
# approved (docs/kaynaklar/<kaynak>.md, tarik_onayi: onaylandi).
KAZUIST_SOURCE_MEVZUAT=
KAZUIST_SOURCE_RESMI_GAZETE=
KAZUIST_SOURCE_KVKK=
KAZUIST_SOURCE_REKABET=
KAZUIST_SOURCE_OPENALEX=
KAZUIST_SOURCE_CROSSREF=
KAZUIST_SOURCE_EURLEX=
# OpenAlex API key (free, https://help.openalex.org/api-reference/authentication).
OPENALEX_API_KEY=
# Anonymiser NER backend key and local model directory (models are never downloaded at run time). The image
# installs the ner-runtime extra; models come from a read-only volume, for example /models/ner. When the
# backend is set and the model is missing, the worker does not start.
KAZUIST_NER_BACKEND=
KAZUIST_NER_DIR=
# onnxruntime intra-op threads (0 = library default) and 1 to load model_quantized.onnx instead of model.onnx.
KAZUIST_NER_THREADS=
KAZUIST_NER_QUANTIZED=
# Set both to 1 in every deployed environment: no model hub access at run time.
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# --- Tests only ---
# Optional real services for apps/web/test/health-deps.test.ts (for example the docker compose stack).
KAZUIST_IT_DATABASE_URL=
KAZUIST_IT_VALKEY_URL=
# Kimlik: hesap silme sonrası kalıcı silmeye kadar bekleme (gün, 1-30; varsayılan 14).
ACCOUNT_PURGE_GRACE_DAYS=14
