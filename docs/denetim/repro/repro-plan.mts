import { randomUUID } from 'node:crypto';
const R = '/Users/baris/Documents/GitHub/Kazuist/packages/ledger/src';
const { BillingService } = await import(`${R}/billing/service.ts`);
const { MemoryBillingStore, MemoryLedgerPort } = await import(`${R}/billing/store.ts`);
const { FakeIyzico, FAKE_CFG } = await import(`${R}/billing/fake-iyzico.ts`);
const { FakeEArsiv } = await import(`${R}/billing/earsiv.ts`);
const buyer = { id: 'u1', email: 'a@example.invalid', name: 'A', surname: 'B', identityNumber: '11111111111', ip: '127.0.0.1', city: 'Ankara', country: 'Turkey', address: 'x' };
const consents = { preInfoConsentVersion: 'onb-1', distanceContractConsentVersion: 'mss-1' };
let now = new Date('2026-10-20T09:00:00Z');
const iyz = new FakeIyzico(); iyz.now = () => now;
const store = new MemoryBillingStore();
const svc = new BillingService({ iyzico: iyz, iyzicoCfg: FAKE_CFG, earsiv: new FakeEArsiv(() => now), store, ledger: new MemoryLedgerPort(), now: () => now, newId: () => randomUUID(), callbackBaseUrl: 'https://k.test', webAddress: 'https://k.test' });
await svc.setupSubscriptionCatalog();
const s1 = await svc.startSubscription('u1', 'key-11111111', { planCode: 'ogrenci.aylik', ...consents }, buyer);
const sub1 = await svc.completeSubscriptionCheckout(store.orders.get(s1.orderId).checkoutToken);
await svc.cancel('u1', sub1.id, 'donem_sonu');
now = new Date('2026-10-25T09:00:00Z');
const s2 = await svc.startSubscription('u1', 'key-22222222', { planCode: 'akademisyen.aylik', ...consents }, buyer);
const sub2 = await svc.completeSubscriptionCheckout(store.orders.get(s2.orderId).checkoutToken);
console.log('plan after upgrade:', await store.getPlan('u1'));
now = sub1.currentPeriodEnd;
await svc.closeEndedPeriods();
console.log('plan after old plan period end:', await store.getPlan('u1'), '| new sub status:', store.subscriptions.get(sub2.id).status);
