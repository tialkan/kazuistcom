#!/bin/sh
# Pre-commit: secret scan of staged changes and text rules. Enable with: pnpm hooks:install
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact || exit 1
else
  echo "warning: gitleaks not installed, secret scan skipped (brew install gitleaks)" >&2
fi
node scripts/check-text.mjs || exit 1
